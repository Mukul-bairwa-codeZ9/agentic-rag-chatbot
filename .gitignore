# --- Standard Ignores ---
node_modules/
.pnpm-store/
apps/frontend/.next/
apps/frontend/out/
apps/frontend/build/
apps/backend/dist/
.env*
*.local
.vscode/
.idea/
.DS_Store
*.log

# --- Backend Data Management ---
# 1. Ignore the entire data directory by default
apps/backend/data/

# 2. Force inclusion of required data files
!apps/backend/data/documents/
!apps/backend/data/order.csv

# 3. Explicitly ignore sensitive/generated files inside data
apps/backend/data/sqlite/
apps/backend/data/*.db
apps/backend/data/*.sqlite